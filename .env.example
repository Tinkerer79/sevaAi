# Copy to .env for local development. Never put provider client secrets here
# unless running the local Supabase Auth stack; OAuth provider secrets belong
# in Supabase Dashboard > Authentication > Sign In / Providers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required by Vercel for AES-256-GCM encryption of complaint contact fields
# and saved AI chat text before it is written to Supabase. Generate with:
# openssl rand -base64 32
PII_ENCRYPTION_KEY=

# Local Express auth uses this. Generate a private random value.
JWT_SECRET=

# Optional local Express admin account. Configure on the backend only.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
